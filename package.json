{
  "name": "ban-nha",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "dev": "npm --workspace web run dev",
    "build": "npm --workspace web run build",
    "preview": "npm --workspace web run preview",
    "lint": "eslint . && prettier --check \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,css}\"",
    "typecheck": "npm --workspace web run typecheck && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run --config web/vitest.config.ts",
    "test:watch": "vitest --config web/vitest.config.ts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "gen:icons": "node scripts/gen-icons.mjs",
    "check:budget": "node scripts/check-budget.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run check:budget"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.1",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vitest": "^3.0.5"
  }
}
