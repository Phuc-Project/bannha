# Cấu hình tham khảo cho Frontend (`frontend/web/js/config.js`)
AUTH_PROVIDER=demo          # 'demo' | 'supabase' | 'firebase'
SUPABASE_URL=
SUPABASE_ANON_KEY=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
ACCOUNT_EMAIL_DOMAIN=bannha.internal

# Backend FastAPI & API Gia sư AI gọn nhẹ
API_BASE_URL=http://127.0.0.1:8000
AI_TUTOR_MODE=backend       # 'backend' | 'direct' | 'local'
AI_TUTOR_ENDPOINT=
AI_TUTOR_API_KEY=
AI_TUTOR_MODEL=gemini-flash-latest
