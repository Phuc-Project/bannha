# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Supabase (local stack: `npx supabase start` prints these values)
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWKS_URL=            # defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=          # only if your local stack still signs tokens with HS256
SUPABASE_SERVICE_ROLE_KEY=        # local: SERVICE_ROLE_KEY in the output of `npx supabase start`
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_SIZE=5

ACCOUNT_EMAIL_DOMAIN=bannha.internal
TIMEZONE=Asia/Ho_Chi_Minh
MAX_UPLOAD_MB=5

# AI Tutor (Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
AI_DAILY_LIMIT_PER_STUDENT=30

# Dorm QR card signing (Ed25519 raw 32-byte private key, base64url; generate via `uv run python -m scripts.gen_qr_key`)
QR_SIGNING_PRIVATE_KEY=
QR_KEY_VERSION=1

# Scheduled reminder job endpoint (`X-Jobs-Secret` header)
JOBS_SECRET=

# Dev-only seed password (`scripts/seed.py`)
# SEED_PASSWORD=
