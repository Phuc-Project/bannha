# Copy to backend/.env for local development. Never commit the real file.
APP_ENV=development
CORS_ORIGINS=http://localhost:5173

# Supabase (local stack: `npx supabase start` prints these values)
SUPABASE_URL=http://127.0.0.1:54321
# SUPABASE_JWKS_URL=            # defaults to <SUPABASE_URL>/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_SECRET=          # only if your local stack still signs tokens with HS256
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:54322/postgres
DB_POOL_SIZE=5

ACCOUNT_EMAIL_DOMAIN=bannha.internal
TIMEZONE=Asia/Ho_Chi_Minh

# Added in later phases
# GEMINI_API_KEY=
# GEMINI_MODEL=
# AI_DAILY_LIMIT_PER_STUDENT=30
# QR_SIGNING_PRIVATE_KEY=
# QR_KEY_VERSION=1
# MAX_UPLOAD_MB=5
# SEED_PASSWORD=
